DATABASE_URL=postgres://smarthome:local-development-only@localhost:5432/smarthome
MONGO_URL=mongodb://localhost:27017
MONGO_DB=smarthome
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=choose-a-local-demo-password
PORT=3000
HEARTBEAT_SECONDS=45
SIMULATOR_ENABLED=true
NOTIFICATION_FAIL=false
# AI inference service (ml/). Compose sets the URL itself; this one is for `npm run server`.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=20000
# Optional shared secret between the API and the inference service.
ML_SERVICE_TOKEN=
